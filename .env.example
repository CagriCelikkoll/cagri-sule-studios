# Copy to .env and replace values. Never commit .env.

# PostgreSQL
POSTGRES_DB=mulakatsim
POSTGRES_USER=mulakatsim
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# MinIO (S3 compatible)
MINIO_ROOT_USER=mulakatsim
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_BUCKET=mulakatsim
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Backend
BACKEND_PORT=8080
ASPNETCORE_ENVIRONMENT=Development

# JWT
JWT_ISSUER=mulakatsim
JWT_AUDIENCE=mulakatsim-web
JWT_SIGNING_KEY=change-me-to-a-long-random-string-at-least-32-chars

# AI service (.NET -> AI service, internal network)
AI_SERVICE_URL=http://ai-service:8000
AI_SERVICE_KEY=change-me-ai-service-key
AI_SERVICE_PORT=8000

# Azure Speech (STT/TTS)
AZURE_SPEECH_KEY=change-me-azure-speech-key
AZURE_SPEECH_REGION=westeurope

# Web
WEB_PORT=3000
