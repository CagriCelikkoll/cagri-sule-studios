{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mulakat-sim.local/schemas/turn-final.schema.json",
  "title": "SSE 'final' olayı verisi",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "text",
    "decision",
    "usage"
  ],
  "properties": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "question_id"
      ],
      "properties": {
        "action": {
          "enum": [
            "follow_up",
            "next_question",
            "wrap_up",
            "end"
          ]
        },
        "question_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": "string",
          "maxLength": 300
        }
      }
    },
    "usage": {
      "type": "object",
      "required": [
        "input_tokens",
        "output_tokens",
        "model"
      ],
      "properties": {
        "input_tokens": {
          "type": "integer"
        },
        "output_tokens": {
          "type": "integer"
        },
        "model": {
          "type": "string"
        },
        "cache_read_tokens": {
          "type": "integer"
        }
      }
    }
  }
}
