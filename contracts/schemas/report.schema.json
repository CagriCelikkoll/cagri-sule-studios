{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mulakat-sim.local/schemas/report.schema.json",
  "title": "Mülakat raporu",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rubric_version",
    "language",
    "overall_score",
    "summary",
    "competency_scores",
    "question_feedback",
    "speech_feedback",
    "next_steps"
  ],
  "properties": {
    "rubric_version": {
      "type": "integer"
    },
    "language": {
      "$ref": "common.schema.json#/$defs/language"
    },
    "overall_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "summary": {
      "type": "string",
      "minLength": 10,
      "maxLength": 600
    },
    "competency_scores": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "competency_id",
          "score",
          "comment",
          "evidence"
        ],
        "properties": {
          "competency_id": {
            "$ref": "common.schema.json#/$defs/competency_id"
          },
          "score": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "comment": {
            "type": "string",
            "maxLength": 400
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "turn_index",
                "quote"
              ],
              "properties": {
                "turn_index": {
                  "type": "integer",
                  "minimum": 0
                },
                "quote": {
                  "type": "string",
                  "maxLength": 200
                }
              }
            }
          }
        }
      }
    },
    "question_feedback": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question_id",
          "strengths",
          "improvements",
          "better_answer_example",
          "star"
        ],
        "properties": {
          "question_id": {
            "type": "string"
          },
          "strengths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "improvements": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "better_answer_example": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1200
          },
          "star": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "situation",
                  "task",
                  "action",
                  "result"
                ],
                "properties": {
                  "situation": {
                    "type": "boolean"
                  },
                  "task": {
                    "type": "boolean"
                  },
                  "action": {
                    "type": "boolean"
                  },
                  "result": {
                    "type": "boolean"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "speech_feedback": {
      "type": "object",
      "required": [
        "comments"
      ],
      "properties": {
        "comments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "language_feedback": {
      "type": [
        "object",
        "null"
      ],
      "description": "Faz 4: İngilizce mülakatlarda dilbilgisi/kelime notları"
    },
    "next_steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "string"
      }
    }
  }
}
