{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mulakat-sim.local/schemas/persona.schema.json",
  "title": "Persona (katalog girdisi)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "display_name",
    "short_description",
    "interview_types",
    "difficulty",
    "languages",
    "competencies"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "display_name": {
      "$ref": "common.schema.json#/$defs/localized"
    },
    "short_description": {
      "$ref": "common.schema.json#/$defs/localized"
    },
    "interview_types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "hr",
          "behavioral",
          "technical",
          "system_design",
          "coding",
          "stress"
        ]
      }
    },
    "difficulty": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/language"
      }
    },
    "voice": {
      "type": "object",
      "properties": {
        "tr": {
          "type": "string"
        },
        "en": {
          "type": "string"
        }
      }
    },
    "competencies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/competency_id"
      }
    }
  }
}
